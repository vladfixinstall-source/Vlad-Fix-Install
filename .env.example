# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Google Sheet ID that powers the Reviews section.
# Setup:
#   1. Create a Google Sheet with first-row headers (lowercase, exact):
#      name, rating, service, date, text
#   2. File → Share → Anyone with the link → Viewer
#   3. Copy the ID from the URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Leave unset to use the static REVIEWS list in app/page.tsx as the only source.
NEXT_PUBLIC_REVIEWS_SHEET_ID=

# Formsubmit.co endpoint that receives contact-form submissions.
# Plain email works for setup; switch to the hashed key (e.g. "el/xxxxxxxx")
# once the address is activated, so the email isn't visible in browser source.
# First submission triggers a one-time confirmation email — click the link in
# it to activate. Without activation, submissions are not delivered.
# Leave unset to keep the form in offline/demo mode (no real delivery).
NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=
