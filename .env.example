# Copy this file to .env.local and fill in real values.
# .env.local is gitignored...

# Google Sheet ID that powers the Reviews section.
# Setup:
#   1. Create a Google Sheet with first-row headers (lowercase, exact):
#      name, rating, service, date, text
#   2. File → Share → Anyone with the link → Viewer
#   3. Copy the ID from the URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Leave unset to use the static REVIEWS list in app/page.tsx as the only source.
NEXT_PUBLIC_REVIEWS_SHEET_ID=

# Web3Forms access key that receives contact-form submissions.
# Setup:
#   1. Visit https://web3forms.com and enter the destination email
#   2. The access key (UUID format) arrives in that email's inbox instantly
#   3. Paste it below — submissions will be delivered to that registered email
# No activation flow, no double-opt-in. Leave unset to keep the form in
# offline/demo mode (success message shown but nothing actually sent).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Google Tag Manager container ID (format: GTM-XXXXXXX). Created at
# https://tagmanager.google.com — the container holds all tracking
# config (triggers, tags, variables) so the code only loads it.
# Leave unset to disable GTM entirely (no script loaded).
NEXT_PUBLIC_GTM_ID=
